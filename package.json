{
  "name": "onescroll",
  "version": "0.1.0",
  "private": true,
  "description": "One short. That's it.",
  "license": "MIT",
  "scripts": {
    "start:firefox": "web-ext run --target firefox-desktop --start-url https://www.youtube.com/shorts",
    "start:chromium": "web-ext run --target chromium --chromium-binary /usr/bin/chromium --start-url https://www.youtube.com/shorts",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest"
  },
  "devDependencies": {
    "web-ext": "^10.8.0"
  }
}
